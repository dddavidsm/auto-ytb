# YouTube market intelligence
YOUTUBE_API_KEY=
YOUTUBE_REGION=US
YOUTUBE_RELEVANCE_LANGUAGE=en

# PostgreSQL
DATABASE_URL=
DATABASE_SSL=false

# Editorial providers
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
TEXT_MODEL_RESEARCH=gpt-5
TEXT_MODEL_CREATIVE=gpt-5
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=

# Media providers
VOICE_PROVIDER=elevenlabs
VOICE_API_KEY=
VOICE_ID=
VOICE_MODEL=eleven_multilingual_v2
VOICE_TIMESTAMPS=true
IMAGE_PROVIDER=runway
IMAGE_API_KEY=
IMAGE_MODEL=gen4_image
VIDEO_PROVIDER=runway
VIDEO_API_KEY=
VIDEO_MODEL=gen4.5

# Provider cost metering. Override rather than editing source when effective rates change.
COST_METER_ROOT=.data/cost-meter
TAVILY_CREDIT_USD=0.008
TEXT_MODEL_INPUT_USD_PER_MILLION=1.25
TEXT_MODEL_OUTPUT_USD_PER_MILLION=10
ELEVENLABS_MULTILINGUAL_USD_PER_1K_CHARS=0.10
ELEVENLABS_FLASH_USD_PER_1K_CHARS=0.05
RUNWAY_CREDIT_USD=0.01
RUNWAY_VIDEO_CREDITS_PER_SECOND=12
RUNWAY_IMAGE_CREDITS_PER_IMAGE=8

# Storage / rendering / final media QA
OBJECT_STORE=local
RENDERER=ffmpeg
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
LOCAL_STORAGE_ROOT=.data/storage
LOCAL_RENDER_ROOT=.data/renders
LOCAL_THUMBNAIL_ROOT=.data/thumbnails
LOCAL_BRAND_ROOT=.data/brand
MIN_ATTENTION_SCORE=86
MAX_ATTENTION_REVISION_PASSES=2

# Content library
CONTENT_LIBRARY_ENABLED=true
CONTENT_LIBRARY_PROVIDER=google-drive
DRIVE_ROOT_FOLDER=AUTO-YTB

# PRIMARY owned-channel OAuth (publishing + analytics + Drive file scope)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_REDIRECT_URI=http://localhost:53682/oauth2/callback

# Additional channels use credentialsRef in config/channels/*.json.
# Example credentialsRef "OWL" => the four variables below.
YOUTUBE_CLIENT_ID__OWL=
YOUTUBE_CLIENT_SECRET__OWL=
YOUTUBE_REFRESH_TOKEN__OWL=
YOUTUBE_CHANNEL_ID__OWL=

# Runtime / autonomy policy
AUTO_UPLOAD_PRIVATE=true
MAX_PRODUCTION_COST_USD=25
PRIMARY_CHANNEL_KEY=future-tech-business-en

# Secure web control plane
# Use independent, random values; SESSION_SECRET should be >=32 chars in production.
CONTROL_PLANE_TOKEN=
SESSION_SECRET=

# Portfolio + automatic channel discovery
PORTFOLIO_DAILY_BUDGET_USD=25
PORTFOLIO_MAX_VIDEOS_PER_DAY=3
AUTO_CHANNEL_DISCOVERY_ENABLED=true
AUTO_NEW_CHANNEL_MIN_SCORE=90

# Intelligence scheduler + public market pattern lab
MARKET_CYCLE_INTERVAL_HOURS=6
MARKET_JOB_PRIORITY=70
MARKET_MAX_QUERIES=5
MARKET_LOOKBACK_DAYS=7
MARKET_CYCLE_MAX_QUERIES=5
MARKET_CYCLE_RECENT_DAYS=7
MARKET_CYCLE_RESULTS_PER_QUERY=35
MARKET_PATTERN_LOOKBACK_DAYS=14

# Autonomous production scheduler
AUTO_PRODUCTION_MIN_SCORE=82
AUTO_PRODUCTION_MAX_PER_DAY=1
AUTO_PRODUCTION_DAILY_BUDGET_USD=25
AUTO_PRODUCTION_RESERVED_COST_USD=18
AUTO_SHORT_RESERVED_COST_USD=6
LEARNING_WINDOW_DAYS=120
ALLOW_COST_EXPERIMENTS=true

# Analytics learning
ANALYTICS_SYNC_DAYS=28
ANALYTICS_JOB_PRIORITY=35
SHORT_TO_LONG_MIN_VIEWS=5000
SHORT_TO_LONG_MIN_AVP=70
LONG_TO_SHORT_MIN_VIEWS=3000
LONG_TO_SHORT_MIN_AVP=50

# Durable worker / scheduler
SCHEDULER_INTERVAL_MS=900000
SCHEDULER_RUN_IMMEDIATELY=true
JOB_MAX_ATTEMPTS=4
JOB_POLL_MS=5000
JOB_STALE_MINUTES=120
JOB_TIMEOUT_MINUTES=120
JOB_RETRY_BASE_MS=60000
JOB_RETRY_MAX_MS=21600000
