# YouTube market intelligence
YOUTUBE_API_KEY=
YOUTUBE_REGION=US
YOUTUBE_RELEVANCE_LANGUAGE=en

# PostgreSQL
DATABASE_URL=
DATABASE_SSL=false

# Gemini unified production stack. One GEMINI_API_KEY can power research grounding,
# structured text, TTS, images and Veo video. Alternatives remain supported below.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Editorial / factual research
SEARCH_PROVIDER=gemini
GEMINI_SEARCH_MODEL=gemini-3.7-flash
# Tavily alternative only:
SEARCH_API_KEY=

# Structured text
TEXT_MODEL_PROVIDER=gemini
TEXT_MODEL_RESEARCH=gemini-3.8-flash
TEXT_MODEL_CREATIVE=gemini-3.8-flash
TEXT_MODEL_VISION=gemini-3.8-flash
GEMINI_TEXT_MODEL=gemini-3.8-flash
# OpenAI alternative only; API billing is independent from ChatGPT subscriptions.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=

# Voice / TTS
VOICE_PROVIDER=gemini
VOICE_ID=Kore
VOICE_MODEL=gemini-3.1-flash-tts-preview
VOICE_TIMESTAMPS=true
# ElevenLabs alternative only:
VOICE_API_KEY=

# Image generation
IMAGE_PROVIDER=gemini
IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K
# Runway alternative only:
IMAGE_API_KEY=

# Video generation
VIDEO_PROVIDER=gemini
VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_VIDEO_RESOLUTION=720p
# Runway alternative only:
VIDEO_API_KEY=

# Provider cost metering. Runtime uses provider/model-aware rates where available;
# override values here instead of editing source when effective rates change.
COST_METER_ROOT=.data/cost-meter
GEMINI_SEARCH_USD_PER_QUERY=0.014
GEMINI_TTS_INPUT_USD_PER_MILLION=1
GEMINI_TTS_OUTPUT_USD_PER_MILLION=20
GEMINI_IMAGE_1K_USD=0.067
GEMINI_VEO_FAST_720P_USD_PER_SECOND=0.10
TAVILY_CREDIT_USD=0.008
TEXT_MODEL_INPUT_USD_PER_MILLION=
TEXT_MODEL_OUTPUT_USD_PER_MILLION=
ELEVENLABS_MULTILINGUAL_USD_PER_1K_CHARS=0.10
ELEVENLABS_FLASH_USD_PER_1K_CHARS=0.05
RUNWAY_CREDIT_USD=0.01
RUNWAY_VIDEO_CREDITS_PER_SECOND=12
RUNWAY_IMAGE_CREDITS_PER_IMAGE=8

# Storage / rendering / final media QA
OBJECT_STORE=local
RENDERER=ffmpeg
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
LOCAL_STORAGE_ROOT=.data/storage
LOCAL_RENDER_ROOT=.data/renders
LOCAL_THUMBNAIL_ROOT=.data/thumbnails
LOCAL_BRAND_ROOT=.data/brand
MIN_ATTENTION_SCORE=86
MAX_ATTENTION_REVISION_PASSES=2

# Audio mastering. Speech is always primary and music is sidechain-ducked under narration.
AUDIO_TARGET_LUFS=-16
AUDIO_TRUE_PEAK_DB=-1.5
AUDIO_LOUDNESS_RANGE=7

# Optional licensed soundtrack library. Leave AUDIO_LIBRARY_MANIFEST empty for voice-only renders.
# Only rightsStatus=CLEARED assets are eligible. By default runtime also requires costUsd=0
# so flat-subscription/public-domain assets do not bypass the provider cost ledger.
AUDIO_LIBRARY_MANIFEST=
AUDIO_MAX_COST_USD_PER_VIDEO=1.5
AUDIO_MUSIC_ENABLED=true
AUDIO_SFX_ENABLED=true
AUDIO_REQUIRE_ZERO_MARGINAL_COST=true

# Content library (may use a completely different Google account from YouTube).
CONTENT_LIBRARY_ENABLED=true
CONTENT_LIBRARY_PROVIDER=google-drive
DRIVE_ROOT_FOLDER=AUTO-YTB
# Exact AUTO-YTB folder ID in the storage account. For the current deployment:
# 1NaSy4ni0np1TXUlk0Zq7FFx9isBDtlp3
DRIVE_ROOT_FOLDER_ID=
# Dedicated Drive OAuth. The OAuth client may be the same Google Cloud app as YouTube,
# but DRIVE_REFRESH_TOKEN must be authorized while signed into the Drive storage account.
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
DRIVE_REDIRECT_URI=http://localhost:53683/oauth2/callback

# PRIMARY owned-channel OAuth (YouTube publishing + analytics only; Drive is separate above).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_REDIRECT_URI=http://localhost:53682/oauth2/callback

# Additional channels use credentialsRef in config/channels/*.json.
# Example credentialsRef "OWL" => the four variables below.
YOUTUBE_CLIENT_ID__OWL=
YOUTUBE_CLIENT_SECRET__OWL=
YOUTUBE_REFRESH_TOKEN__OWL=
YOUTUBE_CHANNEL_ID__OWL=

# Runtime / autonomy policy
AUTO_UPLOAD_PRIVATE=true
MAX_PRODUCTION_COST_USD=25
PRIMARY_CHANNEL_KEY=future-tech-business-en

# Secure web control plane
# Google login is independent from the OAuth identities used by Drive and YouTube.
# Locally the control login can reuse DRIVE_CLIENT_* and the already-authorized Drive callback;
# npm run web:dev starts a bridge from 53683 to the Next.js callback route on port 3000.
CONTROL_GOOGLE_CLIENT_ID=
CONTROL_GOOGLE_CLIENT_SECRET=
CONTROL_GOOGLE_REDIRECT_URI=http://localhost:53683/oauth2/callback
CONTROL_GOOGLE_ALLOWED_EMAILS=
# Emergency fallback login + signed session secret. Keep private and random.
CONTROL_PLANE_TOKEN=
SESSION_SECRET=

# Portfolio + automatic channel discovery
PORTFOLIO_DAILY_BUDGET_USD=25
PORTFOLIO_MAX_VIDEOS_PER_DAY=3
AUTO_CHANNEL_DISCOVERY_ENABLED=true
AUTO_NEW_CHANNEL_MIN_SCORE=90

# Series / persistent IP memory
# A newly discovered recurring series may produce only a small pilot before Analytics must justify CONTINUE/SCALE.
SERIES_PILOT_EPISODES=3
SERIES_EPISODE_PLANNER_MAX_NEW=3
SERIES_EPISODE_MIN_CONFIDENCE=0.45
SERIES_MEMORY_SYNC_LIMIT=4
SERIES_KIDS_QUALITY_SYNC_LIMIT=8
SERIES_PERFORMANCE_MIN_HOURS=6
SERIES_RELEASE_RECHECK_LIMIT=10

# Real visual continuity inspection. Generated keyframes are compared with canonical series references before release.
# Keep enabled for persistent-IP series. Low-detail image inspection is used to constrain cost.
SERIES_VISUAL_CONTINUITY_ENABLED=true
SERIES_VISUAL_CONTINUITY_SYNC_LIMIT=4
SERIES_VISUAL_CONTINUITY_MAX_ASSETS=3
SERIES_VISUAL_MIN_OVERALL=80
SERIES_VISUAL_MIN_CHARACTER=84
SERIES_VISUAL_MIN_STYLE=78

# Intelligence scheduler + public market pattern lab
MARKET_CYCLE_INTERVAL_HOURS=6
MARKET_JOB_PRIORITY=70
MARKET_MAX_QUERIES=5
MARKET_LOOKBACK_DAYS=7
MARKET_CYCLE_MAX_QUERIES=5
MARKET_CYCLE_RECENT_DAYS=7
MARKET_CYCLE_RESULTS_PER_QUERY=35
MARKET_PATTERN_LOOKBACK_DAYS=14

# Autonomous production scheduler
AUTO_PRODUCTION_MIN_SCORE=82
AUTO_PRODUCTION_MAX_PER_DAY=1
AUTO_PRODUCTION_DAILY_BUDGET_USD=25
AUTO_PRODUCTION_RESERVED_COST_USD=18
AUTO_SHORT_RESERVED_COST_USD=6
LEARNING_WINDOW_DAYS=120
ALLOW_COST_EXPERIMENTS=true

# Analytics learning
ANALYTICS_SYNC_DAYS=28
ANALYTICS_JOB_PRIORITY=35
SHORT_TO_LONG_MIN_VIEWS=5000
SHORT_TO_LONG_MIN_AVP=70
LONG_TO_SHORT_MIN_VIEWS=3000
LONG_TO_SHORT_MIN_AVP=50

# Durable worker / scheduler
SCHEDULER_INTERVAL_MS=900000
SCHEDULER_RUN_IMMEDIATELY=true
JOB_MAX_ATTEMPTS=4
JOB_POLL_MS=5000
JOB_STALE_MINUTES=120
JOB_TIMEOUT_MINUTES=120
JOB_RETRY_BASE_MS=60000
JOB_RETRY_MAX_MS=21600000
