{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "auto-ytb-production",
  "account_id": "920501c64c3c0d2e8052baac85973480",
  "workers_dev": true,
  "main": "cloudflare/index.mjs",
  "compatibility_date": "2026-09-24",
  "containers": [
    {
        "class_name": "AutoYtbProductionWebContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1,
      "rollout_step_percentage": 100
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTOYTB_WEB",
        "class_name": "AutoYtbProductionWebContainer"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "AUTOYTB_MEDIA",
      "bucket_name": "auto-ytb-production-media"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AutoYtbWebContainer"]
    },
    {
      "tag": "v2",
      "renamed_classes": [
        {
          "from": "AutoYtbWebContainer",
          "to": "AutoYtbProductionWebContainer"
        }
      ]
    }
  ],
  "vars": {
    "REAL_GENERATION_ENABLED": "false",
    "AUTO_UPLOAD_PRIVATE": "false",
    "AUTO_YTB_RUNTIME_REVISION": "2026-09-25T04:48:18Z",
    "RUN_BACKGROUND_WORKERS": "true",
    "SCHEDULER_INTERVAL_MS": "900000",
    "SCHEDULER_RUN_IMMEDIATELY": "false",
    "GEMINI_API_BASE_URL": "https://generativelanguage.googleapis.com/v1beta",
    "SEARCH_PROVIDER": "gemini",
    "GEMINI_SEARCH_MODEL": "gemini-3.7-flash",
    "TEXT_MODEL_PROVIDER": "gemini",
    "TEXT_MODEL_RESEARCH": "gemini-3.8-flash",
    "TEXT_MODEL_CREATIVE": "gemini-3.8-flash",
    "TEXT_MODEL_VISION": "gemini-3.8-flash",
    "GEMINI_TEXT_MODEL": "gemini-3.8-flash",
    "VOICE_PROVIDER": "gemini",
    "VOICE_ID": "Kore",
    "GEMINI_VOICE_ID": "Kore",
    "VOICE_MODEL": "gemini-3.1-flash-tts-preview",
    "VOICE_TIMESTAMPS": "true",
    "GEMINI_TRANSCRIBE_MODEL": "gemini-3.5-transcribe",
    "VOICE_ALIGNMENT_STRICT": "true",
    "VOICE_ALIGNMENT_MIN_COVERAGE": "0.88",
    "IMAGE_PROVIDER": "gemini",
    "IMAGE_MODEL": "gemini-3.1-flash-image",
    "GEMINI_IMAGE_SIZE": "1K",
    "VIDEO_PROVIDER": "gemini",
    "VIDEO_MODEL": "veo-3.1-fast-generate-preview",
    "GEMINI_VIDEO_RESOLUTION": "720p",
    "OBJECT_STORE": "local",
    "RENDERER": "ffmpeg",
    "FFMPEG_BIN": "ffmpeg",
    "FFPROBE_BIN": "ffprobe",
    "LOCAL_STORAGE_ROOT": ".data/storage",
    "LOCAL_RENDER_ROOT": ".data/renders",
    "LOCAL_THUMBNAIL_ROOT": ".data/thumbnails",
    "LOCAL_BRAND_ROOT": ".data/brand",
    "CONTENT_LIBRARY_ENABLED": "true",
    "CONTENT_LIBRARY_PROVIDER": "google-drive",
    "DRIVE_ROOT_FOLDER": "AUTO-YTB",
    "DRIVE_REDIRECT_URI": "http://localhost:53683/oauth2/callback",
    "YOUTUBE_REGION": "US",
    "YOUTUBE_RELEVANCE_LANGUAGE": "en",
    "YOUTUBE_REDIRECT_URI": "http://localhost:53682/oauth2/callback",
    "PRIMARY_CHANNEL_KEY": "future-tech-business-en",
    "AUTO_CHANNEL_DISCOVERY_ENABLED": "true",
    "AUTO_NEW_CHANNEL_MIN_SCORE": "90",
    "SERIES_VISUAL_CONTINUITY_ENABLED": "true",
    "SERIES_VISUAL_CONTINUITY_MAX_ASSETS": "3",
    "SERIES_VISUAL_MIN_OVERALL": "80",
    "SERIES_VISUAL_MIN_CHARACTER": "84",
    "SERIES_VISUAL_MIN_STYLE": "78",
    "MARKET_CYCLE_INTERVAL_HOURS": "6",
    "MARKET_JOB_PRIORITY": "70",
    "MARKET_MAX_QUERIES": "5",
    "MARKET_LOOKBACK_DAYS": "7",
    "MARKET_CYCLE_MAX_QUERIES": "5",
    "MARKET_CYCLE_RECENT_DAYS": "7",
    "MARKET_CYCLE_RESULTS_PER_QUERY": "35",
    "MARKET_PATTERN_LOOKBACK_DAYS": "14",
    "AUTO_PRODUCTION_MIN_SCORE": "82",
    "AUTO_PRODUCTION_MAX_PER_DAY": "1",
    "AUTO_PRODUCTION_DAILY_BUDGET_USD": "25",
    "AUTO_PRODUCTION_RESERVED_COST_USD": "18",
    "AUTO_SHORT_RESERVED_COST_USD": "6",
    "LEARNING_WINDOW_DAYS": "120",
    "ALLOW_COST_EXPERIMENTS": "true",
    "ANALYTICS_SYNC_DAYS": "28",
    "ANALYTICS_JOB_PRIORITY": "35",
    "SHORT_TO_LONG_MIN_VIEWS": "5000",
    "SHORT_TO_LONG_MIN_AVP": "70",
    "LONG_TO_SHORT_MIN_VIEWS": "3000",
    "LONG_TO_SHORT_MIN_AVP": "50",
    "JOB_MAX_ATTEMPTS": "4",
    "JOB_POLL_MS": "5000",
    "JOB_STALE_MINUTES": "120",
    "JOB_TIMEOUT_MINUTES": "120",
    "JOB_RETRY_BASE_MS": "60000",
    "JOB_RETRY_MAX_MS": "21600000"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
