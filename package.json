{
  "name": "auto-ytb",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && node scripts/test-core.mjs",
    "demo": "npm run build && node apps/cli/dist/demo.js",
    "radar": "npm run build && node apps/cli/dist/radar.js",
    "niches": "npm run build && node apps/cli/dist/niches.js",
    "plan": "npm run build && node apps/cli/dist/plan.js",
    "discover:competitors": "npm run build && node apps/cli/dist/discover-competitors.js",
    "niche:live": "npm run build && node apps/cli/dist/niche-live.js",
    "pipeline:mock": "npm run build && node apps/cli/dist/pipeline-mock.js",
    "test:all": "npm run build && node scripts/test-core.mjs && node scripts/test-pipeline.mjs && node scripts/test-live-adapters.mjs",
    "doctor": "npm run build && node apps/cli/dist/doctor.js",
    "dashboard": "node apps/dashboard/server.mjs",
    "migrate": "npm run build && node scripts/migrate.mjs",
    "oauth:url": "npm run build && node scripts/youtube-oauth.mjs",
    "oauth:exchange": "npm run build && node scripts/youtube-oauth.mjs",
    "analytics:sync": "npm run build && node scripts/analytics-sync.mjs",
    "test:adapters": "npm run build && node scripts/test-live-adapters.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
