{
  "name": "auto-ytb",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && node scripts/test-core.mjs",
    "demo": "npm run build && node apps/cli/dist/demo.js",
    "radar": "npm run build && node apps/cli/dist/radar.js",
    "niches": "npm run build && node apps/cli/dist/niches.js",
    "plan": "npm run build && node apps/cli/dist/plan.js",
    "discover:competitors": "npm run build && node apps/cli/dist/discover-competitors.js",
    "niche:live": "npm run build && node apps/cli/dist/niche-live.js",
    "pipeline:mock": "npm run build && node apps/cli/dist/pipeline-mock.js",
    "pipeline:live": "npm run build && node scripts/live-pipeline.mjs",
    "test:all": "npm run build && node scripts/test-core.mjs && node scripts/test-pipeline.mjs && node scripts/test-format.mjs && node scripts/test-live-adapters.mjs && node scripts/test-ops.mjs",
    "test:adapters": "npm run build && node scripts/test-live-adapters.mjs",
    "test:ops": "npm run build && node scripts/test-ops.mjs",
    "doctor": "npm run build && node apps/cli/dist/doctor.js",
    "dashboard": "node apps/dashboard/server.mjs",
    "migrate": "npm run build && node scripts/migrate.mjs",
    "oauth:url": "npm run build && node scripts/youtube-oauth.mjs",
    "oauth:exchange": "npm run build && node scripts/youtube-oauth.mjs",
    "analytics:sync": "npm run build && node scripts/analytics-sync.mjs",
    "schedule:production": "npm run build && node scripts/schedule-production.mjs",
    "schedule:maintenance": "npm run build && node scripts/schedule-maintenance.mjs",
    "scheduler": "npm run build && node scripts/scheduler.mjs",
    "worker": "npm run build && node scripts/worker.mjs",
    "worker:once": "npm run build && node scripts/worker.mjs --once",
    "ops:schedule": "npm run build && node scripts/schedule-production.mjs && node scripts/schedule-maintenance.mjs",
    "ops:tick": "npm run build && node scripts/schedule-production.mjs && node scripts/schedule-maintenance.mjs && node scripts/worker.mjs --once"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
